{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workspace Environment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_path",
    "analyzed_at",
    "ecosystems",
    "manifests",
    "virtual_environments",
    "package_managers",
    "test_commands",
    "build_commands",
    "tool_availability",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "workspace_path": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute or workspace-relative path analyzed"
    },
    "analyzed_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of analysis"
    },
    "ecosystems": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "node",
          "python",
          "rust",
          "go",
          "java",
          "dotnet",
          "ruby",
          "php",
          "swift",
          "kotlin"
        ]
      },
      "description": "Programming ecosystems detected in workspace"
    },
    "manifests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "type"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Relative path within workspace"
          },
          "type": {
            "type": "string",
            "enum": [
              "manifest",
              "lockfile",
              "config"
            ],
            "description": "Classification of manifest file"
          },
          "ecosystem": {
            "type": "string",
            "description": "Associated programming ecosystem"
          },
          "parseable": {
            "type": "boolean",
            "description": "Whether manifest was successfully parsed"
          },
          "error": {
            "type": "string",
            "description": "Error message if parsing failed"
          }
        }
      }
    },
    "virtual_environments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "path"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "python-venv",
              "python-virtualenv",
              "node-modules",
              "go-vendor",
              "ruby-bundler",
              "java-maven",
              "java-gradle"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Relative path within workspace"
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"],
            "description": "Confidence level of detection"
          }
        }
      }
    },
    "package_managers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "npm",
          "yarn",
          "pnpm",
          "pip",
          "pipenv",
          "poetry",
          "cargo",
          "go",
          "maven",
          "gradle",
          "dotnet",
          "bundler",
          "composer"
        ]
      },
      "description": "Detected or inferred package managers"
    },
    "test_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "ecosystem",
          "confidence",
          "evidence",
          "inferred_from"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1,
            "description": "Test command to execute (e.g., 'npm test', 'pytest')"
          },
          "ecosystem": {
            "type": "string",
            "description": "Associated programming ecosystem"
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"],
            "description": "Confidence level based on evidence"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "manifest",
                    "environment",
                    "lockfile",
                    "script",
                    "config"
                  ],
                  "description": "Type of evidence supporting this inference"
                },
                "path": {
                  "type": "string",
                  "description": "Relative path of evidence file"
                },
                "signal": {
                  "type": "string",
                  "description": "Specific content/name that triggered detection"
                },
                "found": {
                  "type": "boolean",
                  "description": "Whether this evidence was confirmed present"
                }
              }
            },
            "description": "Evidence supporting the inference"
          },
          "inferred_from": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "manifest",
                "environment",
                "lockfile",
                "package_manager"
              ]
            },
            "description": "Sources combined for this inference"
          }
        }
      }
    },
    "build_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "ecosystem",
          "confidence",
          "evidence",
          "inferred_from"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1,
            "description": "Build command to execute (e.g., 'npm run build', 'cargo build')"
          },
          "ecosystem": {
            "type": "string",
            "description": "Associated programming ecosystem"
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "manifest",
                    "environment",
                    "lockfile",
                    "script",
                    "config"
                  ]
                },
                "path": {
                  "type": "string"
                },
                "signal": {
                  "type": "string"
                },
                "found": {
                  "type": "boolean"
                }
              }
            }
          },
          "inferred_from": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "manifest",
                "environment",
                "lockfile",
                "package_manager"
              ]
            }
          }
        }
      }
    },
    "confidence_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "high_confidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "medium_confidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "low_confidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_inferences": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tool_availability": {
      "type": "object",
      "description": "Status of required tools for inferred commands",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["available", "unavailable", "unknown"],
            "description": "Availability of the tool on this machine"
          },
          "version": {
            "type": ["string", "null"],
            "description": "Detected version if available"
          },
          "path": {
            "type": ["string", "null"],
            "description": "Executable path if available"
          },
          "reason": {
            "type": "string",
            "description": "Explanation if unavailable or unknown"
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "malformed_manifest",
              "package_manager_conflict",
              "deep_nested_manifest",
              "missing_workspace",
              "inaccessible_path",
              "parse_error"
            ],
            "description": "Category of diagnostic"
          },
          "severity": {
            "type": "string",
            "enum": ["error", "warning"],
            "description": "Impact level of the diagnostic"
          },
          "path": {
            "type": ["string", "null"],
            "description": "Relative path of affected file or resource"
          },
          "message": {
            "type": "string",
            "description": "Human-readable description of the issue"
          },
          "details": {
            "type": "string",
            "description": "Additional context or technical details"
          }
        }
      },
      "description": "Non-fatal errors, warnings, and informational diagnostics"
    }
  }
}
